# RailHelpAI Safe Environment Configuration Template
# Copy this file to .env for local overrides

APP_NAME="RailHelpAI"
ENV="development"
DEBUG=true

API_HOST="127.0.0.1"
API_PORT=8000
API_V1_PREFIX="/api/v1"

DATABASE_URL="sqlite:///./railhelpai.db"

CLASSIFIER_MODEL_PATH="models/classifier_tfidf_logreg.joblib"
RESOLUTION_MODEL_PATH="models/resolution_time_model.joblib"

LOG_LEVEL="INFO"
