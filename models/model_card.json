    "weighted_recall": 0.949,
    "weighted_f1": 0.9494,
    "train_samples": 8000,
    "test_samples": 2000,
    "classes": [
      "Air Conditioning",
      "Catering",
      "Cleanliness",
      "Coach Maintenance",
      "Electrical",
      "Luggage",
      "Medical",
      "Other",
      "Pest Control",
      "Security",
      "Staff Behaviour",
      "Station Facilities",
      "Ticketing",
      "Water Supply"
